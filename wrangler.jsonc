{
  // Same settings Cloudflare auto-generated on each build, plus not_found_handling
  // so unknown URLs get 404.html (with a 404 status) instead of a blank page.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redundancy-calculator",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
